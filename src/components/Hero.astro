---
---
<section class="relative overflow-hidden bg-gradient-to-br from-[#0a1628] via-[#0d2137] to-[#0a2a40] text-white flex flex-col items-center text-center px-[6%] py-24">
  <!-- Imagen de fondo: dashboard (decorativa) con parallax -->
  <div id="heroParallax" class="hero-parallax absolute inset-0 z-0 flex items-center justify-center overflow-hidden pointer-events-none">
    <img
      src="/hero-dashboard.webp"
      alt=""
      aria-hidden="true"
      width="1400"
      height="787"
      loading="eager"
      fetchpriority="high"
      class="hero-bg-anim w-[78%] max-w-5xl rounded-2xl opacity-45 select-none"
    />
  </div>
  <!-- Overlay parejo para legibilidad del texto -->
  <div class="absolute inset-0 z-0 bg-[#0a1628]/55 pointer-events-none"></div>

  <!-- Glow effects -->
  <div class="absolute -top-52 -left-36 w-[700px] h-[700px] rounded-full bg-purple-700/10 blur-3xl pointer-events-none z-0"></div>
  <div class="absolute -bottom-40 -right-24 w-[500px] h-[500px] rounded-full bg-cyan-500/10 blur-3xl pointer-events-none z-0"></div>

  <span class="relative z-10 inline-block bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:-1px;margin-right:5px"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
    Aplicaciones web para negocios reales
  </span>

  <h1 class="relative z-10 text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight max-w-3xl">
    Apps web para tu negocio,
    <span class="bg-gradient-to-r from-cyan-300 to-purple-400 bg-clip-text text-transparent"> listas en 7 días</span>
  </h1>

  <p class="relative z-10 mt-5 text-lg text-blue-300 max-w-xl">
    Aplicaciones web económicas para mecánicas, peluquerías caninas, gimnasios, barberías y más rubros en Chile. Primer mes gratis.
  </p>

  <div class="relative z-10 mt-10 flex flex-wrap gap-4 justify-center">
    <a
      href="#rubros"
      class="bg-gradient-to-r from-purple-600 to-cyan-500 text-white font-bold px-8 py-3.5 rounded-full shadow-[0_4px_20px_rgba(0,180,216,0.4)] hover:opacity-90 hover:-translate-y-0.5 transition-all"
    >
      Ver rubros disponibles
    </a>
    <a
      href="#contacto"
      class="border-2 border-cyan-500 text-cyan-300 font-bold px-8 py-3.5 rounded-full hover:bg-cyan-500/10 hover:-translate-y-0.5 transition-all"
    >
      Hablar con un asesor
    </a>
  </div>
</section>

<style>
  /* Parallax: el contenedor se desplaza por JS más lento que el scroll */
  .hero-parallax { will-change: transform; }
</style>

<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var el = document.getElementById('heroParallax');
    if (!el) return;
    var ticking = false;
    function update() {
      // el fondo baja a ~40% de la velocidad del scroll → parece "quedarse"
      var y = window.scrollY * 0.4;
      el.style.transform = 'translateY(' + y + 'px)';
      ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    update();
  })();
</script>
